<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin · {{site.name}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="{{fonts_href}}" rel="stylesheet" />
    <style>
      {{{styles}}}
      {{{editor_styles}}}
      {{{font_css}}}
    </style>
    <script>
      var trellisEditor = {{{draft_json}}};
    </script>
  </head>
  <body data-slug="admin">
    <div id="trellis-root" class="page">
      <div id="trellis-body">
        <aside class="left sidebar">
          <div class="page-header">
            <a href="/">
              <h1 class="page-title">{{site.name}}</h1>
            </a>
            <div data-theme-toggle>{{> components/theme-toggle}}</div>
          </div>
        </aside>

        <main class="center">
          <article>
            <header class="page-header">
              <h1 class="page-title">Admin</h1>
              <p class="content-meta">Private publishing tools</p>
            </header>

            <section class="page-content">
              {{#if error}}
                <p role="alert">{{error}}</p>
              {{/if}}
              {{#if uploaded}}
                <p>{{uploaded}} image upload(s) stored.</p>
              {{/if}}
              {{#if saved}}
                <p>{{selected_doc_label}} saved.</p>
              {{/if}}

              {{#if is_import}}
                <nav aria-label="Admin tools">
                  <a href="/admin/list">Posts</a>
                </nav>
                <form action="/admin/import" method="post" enctype="multipart/form-data">
                  <h2>Images</h2>
                  <p>Upload images to compress, deduplicate, and store them in the database.</p>
                  <label>
                    Image files
                    <input type="file" name="files" multiple accept="image/*" />
                  </label>
                  <button type="submit">Upload</button>
                </form>
                {{#if has_images}}
                  <section class="admin-posts" aria-label="Images">
                    <h2>Stored images</h2>
                    <ul>
                      {{#each images}}
                        <li>
                          <div class="admin-post-link">
                            <span>{{short_id}}</span>
                            <small>{{mime}} - {{width}}x{{height}} - {{size_bytes}} bytes</small>
                            <small>{{markdown}}</small>
                          </div>
                        </li>
                      {{/each}}
                    </ul>
                  </section>
                {{/if}}
              {{/if}}

              {{#if is_list}}
                <nav aria-label="Admin tools">
                  <a href="/admin/edit/0">Write from scratch</a>
                  <a href="/admin/import">Images</a>
                </nav>

                <section class="admin-manager" aria-label="Create documents">
                  <form class="admin-inline-form" data-admin-create-folder>
                    <h2>New folder</h2>
                    <label>
                      Name
                      <input type="text" name="name" required placeholder="Projects" />
                    </label>
                    <label>
                      Parent
                      <select name="parent_id">
                        {{#each folder_options}}
                          <option value="{{id}}">{{label}}</option>
                        {{/each}}
                      </select>
                    </label>
                    <label class="admin-checkbox">
                      <input type="checkbox" name="hidden" />
                      Hidden from public view
                    </label>
                    <button type="submit">Create folder</button>
                  </form>

                  <form class="admin-inline-form" data-admin-create-note>
                    <h2>New note</h2>
                    <label>
                      Name
                      <input type="text" name="name" required placeholder="note.md" />
                    </label>
                    <label>
                      Folder
                      <select name="parent_id">
                        {{#each folder_options}}
                          <option value="{{id}}">{{label}}</option>
                        {{/each}}
                      </select>
                    </label>
                    <label class="admin-checkbox">
                      <input type="checkbox" name="draft" checked />
                      Draft
                    </label>
                    <button type="submit">Create note</button>
                  </form>
                </section>

                {{#if has_document_tree}}
                  <section class="admin-posts" aria-label="Documents">
                    <h2>Documents</h2>
                    <ul>
                      {{#each document_tree}}
                        <li class="admin-document-row" style="--admin-depth: {{indent}}px">
                          {{#if is_folder}}
                            <form class="admin-document-card" data-admin-update-folder data-document-id="{{id}}" data-current-parent="{{parent_id}}">
                              <div class="admin-document-main">
                                <strong>Folder</strong>
                                <label>
                                  <span>Name</span>
                                  <input type="text" name="name" value="{{name}}" required />
                                </label>
                                <label>
                                  <span>Parent</span>
                                  <select name="parent_id">
                                    {{#each ../folder_options}}
                                      <option value="{{id}}">{{label}}</option>
                                    {{/each}}
                                  </select>
                                </label>
                                <label class="admin-checkbox">
                                  <input type="checkbox" name="hidden" {{#if hidden}}checked{{/if}} />
                                  Hidden
                                </label>
                              </div>
                              <div class="admin-document-actions">
                                <button type="submit">Save</button>
                                <button type="button" data-admin-delete-document data-document-id="{{id}}" data-document-kind="folder">Delete</button>
                              </div>
                            </form>
                          {{/if}}
                          {{#if is_note}}
                            <form class="admin-document-card{{#if selected}} selected{{/if}}" data-admin-update-note data-document-id="{{id}}" data-current-parent="{{parent_id}}">
                              <div class="admin-document-main">
                                <a href="/admin/edit/{{id}}">
                                  <strong>{{title}}</strong>
                                </a>
                                <label>
                                  <span>Name</span>
                                  <input type="text" name="name" value="{{name}}" required />
                                </label>
                                <label>
                                  <span>Folder</span>
                                  <select name="parent_id">
                                    {{#each ../folder_options}}
                                      <option value="{{id}}">{{label}}</option>
                                    {{/each}}
                                  </select>
                                </label>
                                <label class="admin-checkbox">
                                  <input type="checkbox" name="draft" {{#if draft}}checked{{/if}} />
                                  Draft
                                </label>
                              </div>
                              <div class="admin-document-actions">
                                <a href="/admin/edit/{{id}}">Edit</a>
                                <button type="submit">Save</button>
                                <button type="button" data-admin-delete-document data-document-id="{{id}}" data-document-kind="note">Delete</button>
                              </div>
                            </form>
                          {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  </section>
                {{else}}
                  <section class="admin-posts" aria-label="Documents">
                    <h2>Documents</h2>
                    <p>No notes or folders yet.</p>
                  </section>
                {{/if}}
              {{/if}}

              {{#if is_edit}}
                <nav aria-label="Admin tools">
                  <a href="/admin/list">Posts</a>
                </nav>
                <form data-trellis-editor-form data-save-url="/admin/edit/{{#if selected_doc_id}}{{selected_doc_id}}{{else}}0{{/if}}">
                  <div class="admin-editor-header">
                    <h2>
                      {{#if selected_doc_label}}
                        Edit {{selected_doc_label}}
                      {{else}}
                        {{#if is_first_post_draft}}
                          Write first post
                        {{else}}
                          Draft new post
                        {{/if}}
                      {{/if}}
                    </h2>
                    <button
                      type="button"
                      class="admin-editor-toggle"
                      data-trellis-source-toggle
                      aria-label="Toggle Markdown source"
                      aria-pressed="false"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-code"
                        aria-hidden="true"
                      >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M7 8l-4 4l4 4" />
                        <path d="M17 8l4 4l-4 4" />
                        <path d="M14 4l-4 16" />
                      </svg>
                    </button>
                  </div>
                  <div class="admin-editor-meta">
                    {{#if selected_doc_id}}
                      <label>
                        Name
                        <input type="text" name="name" value="{{selected_doc_name}}" data-trellis-note-name required />
                      </label>
                      <label>
                        Folder
                        <select name="parent_id" data-trellis-note-parent>
                          {{#each folder_options}}
                            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </label>
                      <label class="admin-checkbox">
                        <input type="checkbox" name="draft" data-trellis-note-draft {{#if selected_doc_is_draft}}checked{{/if}} />
                        Draft
                      </label>
                    {{/if}}
                  </div>
                  <input type="hidden" value="{{draft}}" data-trellis-editor-source />
                  <div id="trellis-editor" data-trellis-editor-view="prosemark"></div>
                  <textarea
                    class="admin-source-editor"
                    rows="16"
                    data-trellis-source-view
                    hidden
                  >{{draft}}</textarea>
                  <p role="alert" data-trellis-save-error hidden></p>
                  <button type="submit">
                    {{#if selected_doc_label}}
                      Save {{selected_doc_label}}
                    {{else}}
                      {{#if is_first_post_draft}}
                        Publish index.md
                      {{else}}
                        Create post
                      {{/if}}
                    {{/if}}
                  </button>
                </form>
              {{/if}}

              <form action="/admin/logout" method="post">
                <button type="submit">Sign out</button>
              </form>
            </section>
          </article>
        </main>

        <aside class="right sidebar"></aside>
      </div>
    </div>
    {{#if is_edit}}
      <script type="module" src="/static/editor.js"></script>
    {{/if}}
    <script type="module" src="/static/admin.js"></script>
    <script type="module" src="/static/styles.js"></script>
  </body>
</html>
