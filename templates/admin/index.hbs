<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin · {{site.name}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="{{fonts_href}}" rel="stylesheet" />
    <style>
      {{{styles}}}
      {{{editor_styles}}}
      {{{font_css}}}
    </style>
    <script>
      var trellisEditor = {{{draft_json}}};
    </script>
  </head>
  <body data-slug="admin">
    <div id="trellis-root" class="page">
      <div id="trellis-body">
        <aside class="left sidebar">
          <div class="page-header">
            <a href="/">
              <h1 class="page-title">{{site.name}}</h1>
            </a>
            {{#if site.tagline}}
              <p>{{site.tagline}}</p>
            {{/if}}
            {{> components/search}}
            <div data-theme-toggle>{{> components/theme-toggle}}</div>
          </div>

          {{#if is_list}}
            <nav class="admin-list-sidebar" aria-label="Archive navigation">
              <div class="admin-rail-header">
                <a class="admin-primary-action" href="/admin/edit/0">New post</a>
              </div>
              <div class="admin-side-nav" aria-label="Post filters">
                <button type="button" class="active" data-admin-filter="all"><span>All posts</span><strong>{{notes_count}}</strong></button>
                <button type="button" data-admin-filter="draft"><span>Drafts</span><strong>{{draft_count}}</strong></button>
                <button type="button" data-admin-filter="published"><span>Published</span><strong>{{published_count}}</strong></button>
                <a href="/admin/import"><span>Images</span></a>
                <button type="button" data-admin-filter="hidden"><span>Hidden</span><strong>{{hidden_count}}</strong></button>
              </div>
              <div class="admin-rail-section">
                <div class="admin-rail-title">
                  <span>Folder tree</span>
                  <strong>{{folder_count}}</strong>
                </div>
                <ol class="admin-rail-tree" aria-label="Folders and notes">
                  {{#each document_tree}}
                    <li
                      class="admin-rail-node{{#if is_folder}} is-folder{{/if}}{{#if is_note}} is-note{{/if}}{{#if selected}} active{{/if}}"
                      style="--admin-depth: {{depth}}"
                      data-admin-rail-node
                      data-admin-row-id="{{id}}"
                      data-admin-parent-id="{{parent_id}}"
                      data-admin-kind="{{kind}}"
                    >
                      {{#if is_folder}}
                        <button type="button" class="admin-tree-toggle" data-admin-folder-toggle data-admin-folder-id="{{id}}" aria-label="Toggle {{name}}">
                          <span aria-hidden="true">▸</span>
                        </button>
                        <button type="button" class="admin-tree-label" data-admin-folder-filter="{{id}}">{{name}}</button>
                        <span class="admin-tree-count">{{note_count}}</span>
                      {{/if}}
                      {{#if is_note}}
                        <a class="admin-tree-note" href="/admin/edit/{{id}}">{{title}}</a>
                      {{/if}}
                    </li>
                  {{/each}}
                </ol>
              </div>
            </nav>
          {{else}}
            <nav class="admin-list-sidebar" aria-label="Admin navigation">
              <div class="admin-side-nav">
                <a href="/admin/list"><span>Posts</span></a>
                <a href="/admin/import"><span>Images</span></a>
                <a class="admin-primary-action" href="/admin/edit/0">New post</a>
              </div>
            </nav>
          {{/if}}
          <form class="admin-sidebar-footer" action="/admin/logout" method="post">
            <button type="submit">Sign out</button>
          </form>
        </aside>

        <main class="center">
          <article>
            <section class="page-content{{#if is_edit}} admin-edit-content{{/if}}">
              {{#if error}}
                <p role="alert">{{error}}</p>
              {{/if}}
              {{#if uploaded}}
                <p>{{uploaded}} image upload(s) stored.</p>
              {{/if}}
              {{#if saved}}
                <p>{{selected_doc_label}} saved.</p>
              {{/if}}

              {{#if is_import}}
                <nav aria-label="Admin tools">
                  <a href="/admin/list">Posts</a>
                </nav>
                <form action="/admin/import" method="post" enctype="multipart/form-data">
                  <h2>Images</h2>
                  <p>Upload images to compress, deduplicate, and store them in the database.</p>
                  <label>
                    Image files
                    <input type="file" name="files" multiple accept="image/*" />
                  </label>
                  <button type="submit">Upload</button>
                </form>
                {{#if has_images}}
                  <section class="admin-posts" aria-label="Images">
                    <h2>Stored images</h2>
                    <ul>
                      {{#each images}}
                        <li>
                          <div class="admin-post-link">
                            <span>{{short_id}}</span>
                            <small>{{mime}} - {{width}}x{{height}} - {{size_bytes}} bytes</small>
                            <small>{{markdown}}</small>
                          </div>
                        </li>
                      {{/each}}
                    </ul>
                  </section>
                {{/if}}
              {{/if}}

              {{#if is_list}}
                <div class="admin-list-shell">
                  <div class="admin-list-main">
                    <div class="admin-list-heading">
                      <div>
                        <h2>Publishing workbench</h2>
                        <p>Archive structure, document state, and public visibility.</p>
                      </div>
                      <div class="admin-list-tools" aria-label="List tools">
                        <label>
                          <span class="sr-only">Search posts</span>
                          <input type="search" placeholder="Search posts..." />
                        </label>
                        <select aria-label="Sort posts">
                          <option>Latest first</option>
                          <option>Oldest first</option>
                          <option>Name</option>
                        </select>
                      </div>
                    </div>

                    <div class="admin-command-row">
                      <details class="admin-command">
                        <summary>New folder</summary>
                        <form class="admin-inline-form" data-admin-create-folder>
                          <label>
                            Name
                            <input type="text" name="name" required placeholder="Projects" />
                          </label>
                          <label>
                            Parent
                            <select name="parent_id">
                              {{#each folder_options}}
                                <option value="{{id}}">{{label}}</option>
                              {{/each}}
                            </select>
                          </label>
                          <label class="admin-checkbox">
                            <input type="checkbox" name="hidden" />
                            Hidden
                          </label>
                          <button type="submit">Create folder</button>
                        </form>
                      </details>

                      <details class="admin-command">
                        <summary>New note</summary>
                        <form class="admin-inline-form" data-admin-create-note>
                          <label>
                            Name
                            <input type="text" name="name" required placeholder="note.md" />
                          </label>
                          <label>
                            Folder
                            <select name="parent_id">
                              {{#each folder_options}}
                                <option value="{{id}}">{{label}}</option>
                              {{/each}}
                            </select>
                          </label>
                          <label class="admin-checkbox">
                            <input type="checkbox" name="draft" checked />
                            Draft
                          </label>
                          <button type="submit">Create note</button>
                        </form>
                      </details>
                    </div>

                    {{#if has_document_tree}}
                      <section class="admin-posts admin-document-workbench" aria-label="Documents">
                        <div class="admin-section-heading">
                          <h2>Documents</h2>
                          <p>Showing {{notes_count}} notes and {{folder_count}} folders</p>
                        </div>
                        <div class="admin-document-table" role="table" aria-label="Publishing archive">
                          <div class="admin-document-table-head" role="row">
                            <span>Document</span>
                            <span>Status</span>
                            <span>Parent</span>
                            <span>Updated</span>
                            <span>Actions</span>
                          </div>
                          <div class="admin-document-table-body">
                            {{#each document_tree}}
                              <div
                                class="admin-document-row{{#if is_folder}} is-folder{{/if}}{{#if is_note}} is-note{{/if}}"
                                style="--admin-depth: {{depth}}"
                                data-admin-row
                                data-admin-row-id="{{id}}"
                                data-admin-parent-id="{{parent_id}}"
                                data-admin-kind="{{kind}}"
                                data-admin-draft="{{draft}}"
                                data-admin-hidden="{{hidden}}"
                              >
                                {{#if is_folder}}
                                  <form class="admin-document-card admin-folder-card" data-admin-update-folder data-document-id="{{id}}" data-current-parent="{{parent_id}}">
                                    <div class="admin-document-cell admin-document-name">
                                      <button type="button" class="admin-table-toggle" data-admin-folder-toggle data-admin-folder-id="{{id}}" aria-label="Toggle {{name}}">
                                        <span aria-hidden="true">▸</span>
                                      </button>
                                      <button type="button" class="admin-folder-name" data-admin-folder-filter="{{id}}" data-admin-folder-name-text>{{name}}</button>
                                      <input class="admin-folder-rename" type="text" name="name" value="{{name}}" required data-admin-folder-name-input hidden />
                                      <span class="admin-count">{{note_count}} notes</span>
                                    </div>
                                    <div class="admin-document-cell">
                                      <span class="admin-status-pill">Folder</span>
                                      {{#if hidden}}<span class="admin-status-pill muted">Hidden</span>{{/if}}
                                    </div>
                                    <div class="admin-document-cell admin-muted">{{parent_name}}</div>
                                    <div class="admin-document-cell admin-muted">{{mtime}}</div>
                                    <div class="admin-document-actions">
                                      <label class="admin-checkbox admin-row-checkbox">
                                        <input type="checkbox" name="hidden" {{#if hidden}}checked{{/if}} />
                                        Hidden
                                      </label>
                                      <select name="parent_id" aria-label="Parent folder">
                                        {{#each ../folder_options}}
                                          <option value="{{id}}">{{label}}</option>
                                        {{/each}}
                                      </select>
                                      <button type="submit">Save</button>
                                      <button type="button" data-admin-delete-document data-document-id="{{id}}" data-document-kind="folder">Delete</button>
                                    </div>
                                  </form>
                                {{/if}}
                                {{#if is_note}}
                                  <form class="admin-document-card{{#if selected}} selected{{/if}}" data-admin-update-note data-document-id="{{id}}" data-current-parent="{{parent_id}}">
                                    <div class="admin-document-cell admin-document-name">
                                      <span class="admin-note-indent" aria-hidden="true"></span>
                                      <a href="/admin/edit/{{id}}">
                                        <strong>{{title}}</strong>
                                        <small>{{name}}</small>
                                      </a>
                                      <input type="hidden" name="name" value="{{name}}" required />
                                    </div>
                                    <div class="admin-document-cell">
                                      {{#if draft}}
                                        <span class="admin-status-pill muted">Draft</span>
                                      {{else}}
                                        <span class="admin-status-pill">Published</span>
                                      {{/if}}
                                      {{#if hidden}}<span class="admin-status-pill muted">Hidden</span>{{/if}}
                                    </div>
                                    <div class="admin-document-cell admin-muted">{{parent_name}}</div>
                                    <div class="admin-document-cell admin-muted">{{mtime}}</div>
                                    <div class="admin-document-actions">
                                      <a href="/admin/edit/{{id}}">Edit</a>
                                      <label class="admin-checkbox admin-row-checkbox">
                                        <input type="checkbox" name="draft" {{#if draft}}checked{{/if}} />
                                        Draft
                                      </label>
                                      <select name="parent_id" aria-label="Folder">
                                        {{#each ../folder_options}}
                                          <option value="{{id}}">{{label}}</option>
                                        {{/each}}
                                      </select>
                                      <button type="submit">Save</button>
                                      <button type="button" data-admin-delete-document data-document-id="{{id}}" data-document-kind="note">Delete</button>
                                    </div>
                                  </form>
                                {{/if}}
                              </div>
                            {{/each}}
                          </div>
                        </div>
                      </section>
                    {{else}}
                      <section class="admin-posts" aria-label="Documents">
                        <h2>Documents</h2>
                        <p>No notes or folders yet.</p>
                      </section>
                    {{/if}}
                  </div>
                </div>
              {{/if}}

              {{#if is_edit}}
                <nav aria-label="Admin tools">
                  <a href="/admin/list">Posts</a>
                </nav>
                <form class="admin-editor-form" data-trellis-editor-form data-save-url="/admin/edit/{{#if selected_doc_id}}{{selected_doc_id}}{{else}}0{{/if}}">
                  <div class="admin-editor-header">
                    <h2>
                      {{#if selected_doc_label}}
                        Edit {{selected_doc_label}}
                      {{else}}
                        {{#if is_first_post_draft}}
                          Write first post
                        {{else}}
                          Draft new post
                        {{/if}}
                      {{/if}}
                    </h2>
                    <button
                      type="button"
                      class="admin-editor-toggle"
                      data-trellis-source-toggle
                      aria-label="Toggle Markdown source"
                      aria-pressed="false"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-code"
                        aria-hidden="true"
                      >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M7 8l-4 4l4 4" />
                        <path d="M17 8l4 4l-4 4" />
                        <path d="M14 4l-4 16" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="admin-editor-preview"
                      data-trellis-preview-toggle
                      aria-pressed="false"
                    >Preview</button>
                  </div>
                  <div class="admin-editor-meta">
                    {{#if selected_doc_id}}
                      <label>
                        Name
                        <input type="text" name="name" value="{{selected_doc_name}}" data-trellis-note-name required />
                      </label>
                      <label>
                        Folder
                        <select name="parent_id" data-trellis-note-parent>
                          {{#each folder_options}}
                            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </label>
                      <label class="admin-checkbox">
                        <input type="checkbox" name="draft" data-trellis-note-draft {{#if selected_doc_is_draft}}checked{{/if}} />
                        Draft
                      </label>
                    {{/if}}
                  </div>
                  <input type="hidden" value="{{draft}}" data-trellis-editor-source />
                  <div id="trellis-editor" data-trellis-editor-view="prosemark"></div>
                  <section
                    class="admin-editor-preview-pane page-content"
                    data-renderer="rushdown"
                    data-trellis-preview
                    hidden
                  ></section>
                  <textarea
                    class="admin-source-editor"
                    rows="16"
                    data-trellis-source-view
                    hidden
                  >{{draft}}</textarea>
                  <p role="alert" data-trellis-save-error hidden></p>
                  <button type="submit">
                    {{#if selected_doc_label}}
                      Save {{selected_doc_label}}
                    {{else}}
                      {{#if is_first_post_draft}}
                        Publish index.md
                      {{else}}
                        Create post
                      {{/if}}
                    {{/if}}
                  </button>
                </form>
              {{/if}}

            </section>
          </article>
        </main>

      </div>
    </div>
    {{#if is_edit}}
      <script type="module" src="/static/assets/editor.js"></script>
    {{/if}}
    <script type="module" src="/static/assets/admin-shell.js"></script>
    <script type="module" src="/static/assets/admin.js"></script>
  </body>
</html>
