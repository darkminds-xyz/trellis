<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{article.title}} · {{site.name}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="{{fonts_href}}" rel="stylesheet" />
    <style>
      {{{styles}}}
      {{{font_css}}}
    </style>
  </head>
  <body data-slug="{{article.slug}}">
    <div id="trellis-root" class="page">
      <div id="trellis-body">
        <aside class="left sidebar">
          <div class="page-header">
            <a href="/">
              <h1 class="page-title">{{site.name}}</h1>
            </a>
            {{#if site.tagline}}
              <p>{{site.tagline}}</p>
            {{/if}}
            {{> components/search}}
            <div data-theme-toggle>{{> components/theme-toggle}}</div>
          </div>

          {{> components/explorer}}
        </aside>

        <main class="center">
          <article>
            <header class="page-header">
              <div class="popover-hint">
                <div class="page-title-row">
                  <h1 class="page-title article-title">{{article.title}}</h1>
                  {{#if article.edit_url}}
                    <a class="page-title-action" href="{{article.edit_url}}" aria-label="Edit {{article.title}}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-edit" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                        <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415" />
                        <path d="M16 5l3 3" />
                      </svg>
                    </a>
                  {{/if}}
                </div>
                {{#if article.created}}
                  <p class="content-meta">Created, {{article.created}}</p>
                {{/if}}
                <p class="content-update">
                  {{#if article.updated}}
                    Updated, {{article.updated}},
                  {{/if}}
                  {{article.read_time}}
                </p>
              </div>
            </header>
            <div class="popover-hint">
              {{> taglist}}
            </div>
            <section class="page-content popover-hint" data-renderer="rushdown">
              {{{article.html}}}
            </section>
          </article>
          <footer>
            <p>Created with
              <a href="https://trellis.studium.dev/">Trellis v{{footer.version}}</a>
              ©
              {{footer.year}}</p>
            {{#if footer.links}}
              <ul>
                {{#each footer.links}}
                  <li><a href="{{href}}">{{text}}</a></li>
                {{/each}}
              </ul>
            {{/if}}
          </footer>
        </main>

        <aside class="right sidebar">
          {{#if article.toc.enabled}}
            <nav class="toc" aria-label="Table of contents">
              <button id="toc" class="toc-header" type="button" aria-label="Toggle table of contents">
                <h3>Table of contents</h3>
                <span class="fold" aria-hidden="true">▾</span>
              </button>
              <ul class="toc-content overflow">
                {{#each article.toc.items}}
                  <li class="depth-{{depth}}">
                    <a href="#{{id}}" data-for="{{id}}">{{title}}</a>
                  </li>
                {{/each}}
              </ul>
            </nav>
          {{/if}}
          {{> components/graph}}
          {{> components/backlinks}}
        </aside>
      </div>
    </div>

    <script>
      window.fetchData = fetch("/static/context-index.json").then(r => r.json()).catch(() => undefined);
    </script>
    {{#if scripts.explorer}}
      <script type="module">{{{scripts.explorer}}}</script>
    {{/if}}
    {{#if scripts.overlay_explorer}}
      <script type="module">{{{scripts.overlay_explorer}}}</script>
    {{/if}}
    {{#if scripts.encrypted_note}}
      <script type="module">{{{scripts.encrypted_note}}}</script>
    {{/if}}
    {{#if scripts.callouts}}
      <script type="module">{{{scripts.callouts}}}</script>
    {{/if}}
    <script type="module" src="/static/assets/graph.js"></script>
    {{#if scripts.mermaid}}
      <script type="module">{{{scripts.mermaid}}}</script>
    {{/if}}
    <script type="module" src="/static/assets/site.js"></script>
  </body>
</html>
